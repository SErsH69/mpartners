{
    "name": "webula/starter-theme",
    "type": "project",
    "description": "Webula WordPress starter theme with a reusable spacer ACF block.",
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpcsstandards/phpcsutils": "^1.0",
        "squizlabs/php_codesniffer": "^3.8",
        "php-stubs/acf-pro-stubs": "^6.2",
        "php-stubs/wordpress-globals": "^0.2.0",
        "php-stubs/wordpress-stubs": "^6.4",
        "micheh/phpcs-gitlab": "^1.1",
        "phpstan/phpstan": "^1.10",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^1.1",
        "phpmd/phpmd": "^2.15",
        "phpunit/phpunit": "^11.3",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "10up/wp_mock": "^0.4.2"
    },
    "scripts": {
        "check": "phpcs -s",
        "fix": "phpcbf",
        "md": "phpmd theme json codesize,unusedcode,naming,design,controversial,cleancode --exclude theme/dist,theme/vendor,vendor",
        "analyse": "php -d memory_limit=1G vendor/bin/phpstan analyse",
        "tests": "phpunit"
    }
}
