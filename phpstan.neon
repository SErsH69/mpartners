includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
parameters:
    level: 4
    paths:
        - theme/
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - vendor/php-stubs/acf-pro-stubs/acf-pro-stubs.php
    ignoreErrors:
        - '#Variable \$args might not be defined#'